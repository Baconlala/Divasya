# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role / "secret" key — server-only, NEVER prefix with NEXT_PUBLIC_.
# Only used for admin user management (/admin/users). Treat it like a
# password: if it's ever pasted somewhere insecure, regenerate it.
SUPABASE_SERVICE_ROLE_KEY=

# The site's public URL, used for social share previews (Open Graph image).
# Set this to your real Vercel URL once you have one.
NEXT_PUBLIC_SITE_URL=https://divasya-lime.vercel.app
